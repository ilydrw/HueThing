{
  "name": "huething",
  "version": "1.0.1",
  "description": "Control your Philips Hue lights from your Car Thing",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build.js",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "smoke:startup": "node test-startup.mjs",
    "smoke:discovery": "node test-discovery.cjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@deskthing/client": "^0.11.2",
    "@deskthing/server": "^0.11.6",
    "multicast-dns": "^7.2.5",
    "node-dtls-client": "^1.1.1"
  },
  "devDependencies": {
    "@deskthing/cli": "^0.11.15",
    "@deskthing/types": "^0.11.18",
    "@types/adm-zip": "^0.5.7",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^25.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.27.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsm": "^2.3.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vite-plugin-css-injected-by-js": "^4.0.1"
  }
}
